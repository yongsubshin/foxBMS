/* ========== Composite Safety Checks ====================================== */

{% for safety_check in safety_checks | default([]) %}
/**
 * @brief   {{ safety_check.description }}
 * @details ASIL-{{ safety_check.asil_level | default(asil_level) | default('B') }} safety check.
 *          MISRA Rule: {{ safety_check.misra_rule | default('N/A') }}
{% for param in safety_check.parameters %}
 * @param   {{ param.name }} {{ param.description }}
{% endfor %}
 * @return  true if all safety conditions are met, false otherwise
 * @req     {{ safety_check.requirement_id | default(requirement_id) }}
 */
bool {{ prefix | upper }}_{{ safety_check.name }}(
{% for param in safety_check.parameters %}
    {{ param.type }} {{ param.name }}{% if not loop.last %},{% endif %}

{% endfor %}
) {
    bool isSafe = true;

{% for condition in safety_check.conditions %}
    /* Check: {{ condition.description }} */
    if (!({{ condition.expression }})) {
        isSafe = false;
{% if condition.diagnostic_id is defined %}
        /* Report diagnostic */
        DIAG_Handler({{ condition.diagnostic_id }}, DIAG_EVENT_NOT_OK, DIAG_SYSTEM, 0u);
{% endif %}
    }

{% endfor %}
    return isSafe;
}

{% endfor %}

