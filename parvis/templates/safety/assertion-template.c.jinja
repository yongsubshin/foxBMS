 * @return  Number of assertion failures since initialization
 * @req     {{ requirement_id }}
 */
uint32_t {{ prefix | upper }}_GetAssertionFailureCount(void) {
    return {{ prefix | lower }}_assertionFailureCount;
}

/**
 * @brief   Resets the assertion failure count
 * @details Should only be called during testing or after error recovery.
 * @req     {{ requirement_id }}
 */
void {{ prefix | upper }}_ResetAssertionFailureCount(void) {
    {{ prefix | lower }}_assertionFailureCount = 0u;
}

/**
 * @brief   Gets information about the last assertion failure
 * @param   file Pointer to store file name (output)
 * @param   line Pointer to store line number (output)
 * @return  true if assertion info is available, false if no assertion has occurred
 * @req     {{ requirement_id }}
 */
bool {{ prefix | upper }}_GetLastAssertionInfo(const char** file, uint32_t* line) {
    bool infoAvailable = false;

    /* FAS_ASSERT: Output pointers must not be NULL */
    FAS_ASSERT(file != NULL);
    FAS_ASSERT(line != NULL);

    if ({{ prefix | lower }}_lastAssertionInfo.file != NULL) {
        *file = {{ prefix | lower }}_lastAssertionInfo.file;
        *line = {{ prefix | lower }}_lastAssertionInfo.line;
        infoAvailable = true;
    }

    return infoAvailable;
}

