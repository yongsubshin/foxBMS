 */
#define {{ prefix | upper }}_ASIL_QM      (0u)

/**
 * @def     {{ prefix | upper }}_ASIL_A
 * @brief   ASIL A safety integrity level
 */
#define {{ prefix | upper }}_ASIL_A       (1u)

/**
 * @def     {{ prefix | upper }}_ASIL_B
 * @brief   ASIL B safety integrity level
 */
#define {{ prefix | upper }}_ASIL_B       (2u)

/**
