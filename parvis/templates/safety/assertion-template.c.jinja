/* ========== Assertion Configuration ====================================== */

/**
 * @def     {{ prefix | upper }}_ASSERT_ENABLED
 * @brief   Enable/disable runtime assertions (1u = enabled)
 */
#define {{ prefix | upper }}_ASSERT_ENABLED (1u)

/**
 * @def     {{ prefix | upper }}_ASSERT_LOG_ENABLED
 * @brief   Enable/disable assertion logging (1u = enabled)
 */
#define {{ prefix | upper }}_ASSERT_LOG_ENABLED (1u)

/* ========== MISRA C:2012 Compliant Assertion Macros ====================== */

/**
 * @def     {{ prefix | upper }}_ASSERT(condition)
 * @brief   Runtime assertion macro
 * @details Validates condition and triggers FAS_ASSERT on failure.
 *          MISRA C:2012 Rule 11.9: NULL check uses explicit comparison.
 * @param   condition Boolean expression to validate
 */
#if ({{ prefix | upper }}_ASSERT_ENABLED == 1u)
    #define {{ prefix | upper }}_ASSERT(condition) \
        do { \
            if ((condition) == false) { \
                FAS_ASSERT(FAS_TRAP); \
            } \
        } while (false)
#else
    #define {{ prefix | upper }}_ASSERT(condition) ((void)0)
#endif

/**
 * @def     {{ prefix | upper }}_ASSERT_MSG(condition, message)
 * @brief   Assertion with diagnostic message
 * @param   condition Boolean expression to validate
 * @param   message Diagnostic message (unused in release builds)
 */
#if ({{ prefix | upper }}_ASSERT_ENABLED == 1u) && ({{ prefix | upper }}_ASSERT_LOG_ENABLED == 1u)
    #define {{ prefix | upper }}_ASSERT_MSG(condition, message) \
        do { \
            if ((condition) == false) { \
                /* Log assertion failure */ \
                FAS_ASSERT(FAS_TRAP); \
            } \
        } while (false)
#else
    #define {{ prefix | upper }}_ASSERT_MSG(condition, message) ((void)0)
#endif

/*========== Static Constant and Variable Definitions =======================*/

/** @brief Counter for assertion failures */
static uint32_t {{ prefix | lower }}_assertionFailureCount = 0u;

/** @brief Last assertion failure location */
static struct {
    const char* file;
    uint32_t line;
    uint32_t timestamp_ms;
} {{ prefix | lower }}_lastAssertionInfo = {
    .file = NULL,
    .line = 0u,
    .timestamp_ms = 0u
};

/*========== Extern Constant and Variable Definitions =======================*/

/*========== Static Function Prototypes =====================================*/

/**
 * @brief   Records assertion failure information
 * @param   file Source file name
 * @param   line Source line number
 */
static void {{ prefix | upper }}_RecordAssertionFailure(const char* file, uint32_t line);

/*========== Static Function Implementations ================================*/

static void {{ prefix | upper }}_RecordAssertionFailure(const char* file, uint32_t line) {
    {{ prefix | lower }}_assertionFailureCount++;
    {{ prefix | lower }}_lastAssertionInfo.file = file;
    {{ prefix | lower }}_lastAssertionInfo.line = line;
    /* Note: Timestamp would be set via OS_GetTickCount() if available */
}

