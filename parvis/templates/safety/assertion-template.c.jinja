/* ========== Pointer Validation Functions ================================= */

/**
 * @brief   Validates that a pointer is not NULL
 * @details MISRA C:2012 Rule 11.9 compliant NULL check.
 *          ASIL-{{ asil_level | default('B') }} safety function.
 * @param   ptr Pointer to validate
 * @return  true if pointer is valid (not NULL), false otherwise
 * @req     {{ requirement_id }}
 */
bool {{ prefix | upper }}_ValidatePointerNotNull(const void* ptr) {
    bool isValid = false;

    /* MISRA C:2012 Rule 11.9: Explicit NULL comparison */
    if (ptr != NULL) {
        isValid = true;
    }

    return isValid;
}

/**
 * @brief   Asserts that a pointer is not NULL
 * @details Triggers FAS_ASSERT on NULL pointer.
 * @param   ptr Pointer to validate
 * @param   paramName Name of parameter for diagnostics
 * @req     {{ requirement_id }}
 */
void {{ prefix | upper }}_AssertPointerNotNull(const void* ptr, const char* paramName) {
    /* FAS_ASSERT: Pointer must not be NULL */
    FAS_ASSERT(ptr != NULL);

    /* Suppress unused parameter warning in release builds */
    (void)paramName;
}

/* ========== Range Validation Functions =================================== */

{% for range_check in range_checks | default([]) %}
/**
 * @brief   Validates {{ range_check.name }} is within allowed range
 * @details Checks if value is between {{ range_check.min }} and {{ range_check.max }}.
 *          ASIL-{{ range_check.asil_level | default(asil_level) | default('B') }} safety function.
 * @param   value Value to validate
 * @return  true if value is within range, false otherwise
 * @req     {{ range_check.requirement_id | default(requirement_id) }}
 */
bool {{ prefix | upper }}_Validate{{ range_check.name | title }}Range({{ range_check.type }} value) {
    bool isValid = false;

    /* MISRA C:2012 Rule 14.3: Avoid always-true/false conditions */
    if ((value >= ({{ range_check.type }}){{ range_check.min }}) &&
        (value <= ({{ range_check.type }}){{ range_check.max }})) {
        isValid = true;
    }

    return isValid;
}

/**
 * @brief   Asserts {{ range_check.name }} is within allowed range
 * @details Triggers FAS_ASSERT if value is out of range.
 * @param   value Value to validate
 * @req     {{ range_check.requirement_id | default(requirement_id) }}
 */
void {{ prefix | upper }}_Assert{{ range_check.name | title }}Range({{ range_check.type }} value) {
    /* FAS_ASSERT: Value must be within valid range */
    FAS_ASSERT({{ prefix | upper }}_Validate{{ range_check.name | title }}Range(value) == true);
}

{% endfor %}

/* ========== Array Bounds Validation ====================================== */

/**
 * @brief   Validates array index is within bounds
 * @details MISRA C:2012 Rule 18.1 compliant bounds check.
 * @param   index Index to validate
 * @param   arraySize Size of the array
 * @return  true if index is within bounds, false otherwise
 * @req     {{ requirement_id }}
 */
bool {{ prefix | upper }}_ValidateArrayBounds(uint32_t index, uint32_t arraySize) {
    bool isValid = false;

    /* MISRA C:2012 Rule 18.1: Array index must be within bounds */
    if (index < arraySize) {
        isValid = true;
    }

    return isValid;
}

/**
 * @brief   Asserts array index is within bounds
 * @details Triggers FAS_ASSERT if index is out of bounds.
 * @param   index Index to validate
 * @param   arraySize Size of the array
 * @req     {{ requirement_id }}
 */
void {{ prefix | upper }}_AssertArrayBounds(uint32_t index, uint32_t arraySize) {
    /* FAS_ASSERT: Array index must be within bounds */
    FAS_ASSERT(index < arraySize);
}

