/**
 * @brief   Validates if a state value is within valid range
 * @param   state The state value to validate
 * @return  true if state is valid, false otherwise
 * @req     {{ requirement_id }}
 */
static inline bool {{ prefix | upper }}_IsValidState({{ prefix | upper }}_STATE_e state) {
    bool isValid = false;

    /* MISRA C:2012 Rule 10.4: Use explicit comparison */
    if ((uint8_t)state < {{ prefix | upper }}_NUMBER_OF_STATES) {
        isValid = true;
    }

    return isValid;
}

/**
 * @brief   Gets the string representation of a state
 * @param   state The state to convert to string
 * @return  Pointer to state name string
 * @req     {{ requirement_id }}
 */
static const char* {{ prefix | upper }}_GetStateName({{ prefix | upper }}_STATE_e state) {
    static const char* stateNames[{{ prefix | upper }}_NUMBER_OF_STATES] = {
{% for state in states %}
        "{{ state.name | upper }}"{% if not loop.last %},{% endif %}

{% endfor %}
    };

    const char* name = "UNKNOWN";

    if ({{ prefix | upper }}_IsValidState(state) == true) {
        name = stateNames[(uint8_t)state];
    }

    return name;
}
{% endif %}

