/**
 * @brief   State transition result enumeration
 * @details Defines possible results of state transition attempts.
 * @req     {{ requirement_id }}
 */
typedef enum {
    /** @brief Transition completed successfully */
    {{ prefix | upper }}_TRANSITION_OK = 0u,
    /** @brief Transition failed due to invalid current state */
    {{ prefix | upper }}_TRANSITION_INVALID_STATE = 1u,
    /** @brief Transition failed due to invalid target state */
    {{ prefix | upper }}_TRANSITION_INVALID_TARGET = 2u,
    /** @brief Transition not allowed from current state */
    {{ prefix | upper }}_TRANSITION_NOT_ALLOWED = 3u
} {{ prefix | upper }}_TRANSITION_RESULT_e;

/**
 * @brief   State machine context structure
 * @details Contains all state-related information for {{ state_machine_name }}.
 * @req     {{ requirement_id }}
 */
typedef struct {
    /** @brief Current state of the state machine */
    {{ prefix | upper }}_STATE_e currentState;
    /** @brief Previous state before last transition */
    {{ prefix | upper }}_STATE_e previousState;
    /** @brief Timestamp of last state change in milliseconds */
    uint32_t lastTransitionTimestamp_ms;
    /** @brief Counter for total state transitions */
    uint32_t transitionCount;
    /** @brief Flag indicating if state machine is initialized */
