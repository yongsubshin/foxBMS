static void {{ prefix | upper }}_ExecuteExitActions({{ prefix | upper }}_STATE_e oldState);

/*========== Static Function Implementations ================================*/

static bool {{ prefix | upper }}_ValidateTransitionPreconditions({{ prefix | upper }}_STATE_e targetState) {
    bool preconditionsMet = true;
    uint32_t currentTime_ms = 0u;
    uint32_t timeSinceLastTransition_ms = 0u;

    /* Get current system time */
    currentTime_ms = OS_GetTickCount();

    /* Calculate time since last transition */
    if (currentTime_ms >= {{ prefix | lower }}_stateContext.lastTransitionTimestamp_ms) {
        timeSinceLastTransition_ms = currentTime_ms - {{ prefix | lower }}_stateContext.lastTransitionTimestamp_ms;
    } else {
        /* Handle timer overflow */
        timeSinceLastTransition_ms = (UINT32_MAX - {{ prefix | lower }}_stateContext.lastTransitionTimestamp_ms) + currentTime_ms + 1u;
    }

    /* Check minimum transition interval */
    if (timeSinceLastTransition_ms < {{ prefix | upper }}_MIN_TRANSITION_INTERVAL_MS) {
        preconditionsMet = false;
    }

    /* Validate target state is in valid range */
    if ({{ prefix | upper }}_IsValidState(targetState) == false) {
        preconditionsMet = false;
    }

{% for state in states %}
{% if state.entry_preconditions is defined %}
    /* Preconditions for {{ state.name | upper }} */
    if (targetState == {{ prefix | upper }}_STATE_{{ state.name | upper }}) {
{% for precondition in state.entry_preconditions %}
        /* {{ precondition.description }} */
        if (!({{ precondition.condition }})) {
            preconditionsMet = false;
        }
{% endfor %}
    }
{% endif %}
{% endfor %}

    return preconditionsMet;
}

static void {{ prefix | upper }}_ExecuteEntryActions({{ prefix | upper }}_STATE_e newState) {
    /* Execute state-specific entry actions */
    switch (newState) {
{% for state in states %}
        case {{ prefix | upper }}_STATE_{{ state.name | upper }}:
{% if state.entry_actions is defined %}
{% for action in state.entry_actions %}
            /* {{ action.description | default('Entry action') }} */
            {{ action.code }};
{% endfor %}
{% else %}
            /* No entry actions defined */
{% endif %}
            break;
{% endfor %}
        default:
            /* MISRA C:2012 Rule 16.4: All switch cases must have default */
            FAS_ASSERT(FAS_TRAP);
            break;
    }
}

static void {{ prefix | upper }}_ExecuteExitActions({{ prefix | upper }}_STATE_e oldState) {
    /* Execute state-specific exit actions */
    switch (oldState) {
{% for state in states %}
        case {{ prefix | upper }}_STATE_{{ state.name | upper }}:
{% if state.exit_actions is defined %}
{% for action in state.exit_actions %}
            /* {{ action.description | default('Exit action') }} */
            {{ action.code }};
{% endfor %}
{% else %}
            /* No exit actions defined */
{% endif %}
            break;
{% endfor %}
        default:
            /* MISRA C:2012 Rule 16.4: All switch cases must have default */
            FAS_ASSERT(FAS_TRAP);
            break;
    }
}

/*========== Extern Function Implementations ================================*/

/**
 * @brief   Initializes the {{ state_machine_name }} state machine
 * @details Sets up initial state and clears all counters.
 * @return  STD_OK on success, STD_NOT_OK on failure
 * @req     {{ requirement_id }}
 */
STD_RETURN_TYPE_e {{ prefix | upper }}_Initialize(void) {
    STD_RETURN_TYPE_e retval = STD_OK;

    /* Initialize state context */
    {{ prefix | lower }}_stateContext.currentState = {{ prefix | upper }}_STATE_{{ initial_state | upper | default('IDLE') }};
    {{ prefix | lower }}_stateContext.previousState = {{ prefix | upper }}_STATE_{{ initial_state | upper | default('IDLE') }};
    {{ prefix | lower }}_stateContext.lastTransitionTimestamp_ms = OS_GetTickCount();
    {{ prefix | lower }}_stateContext.transitionCount = 0u;
    {{ prefix | lower }}_stateContext.initialized = true;

    /* Execute entry actions for initial state */
    {{ prefix | upper }}_ExecuteEntryActions({{ prefix | lower }}_stateContext.currentState);

    return retval;
}

/**
 * @brief   Attempts a state transition
 * @details Validates the transition and executes if allowed.
 * @param   targetState The target state to transition to
 * @return  Transition result indicating success or failure reason
 * @req     {{ requirement_id }}
 */
{{ prefix | upper }}_TRANSITION_RESULT_e {{ prefix | upper }}_TransitionTo({{ prefix | upper }}_STATE_e targetState) {
    {{ prefix | upper }}_TRANSITION_RESULT_e result = {{ prefix | upper }}_TRANSITION_OK;
    {{ prefix | upper }}_STATE_e currentState = {{ prefix | lower }}_stateContext.currentState;

    /* FAS_ASSERT: State machine must be initialized */
    FAS_ASSERT({{ prefix | lower }}_stateContext.initialized == true);

    /* Validate current state */
    if ({{ prefix | upper }}_IsValidState(currentState) == false) {
        result = {{ prefix | upper }}_TRANSITION_INVALID_STATE;
    }
    /* Validate target state */
    else if ({{ prefix | upper }}_IsValidState(targetState) == false) {
        result = {{ prefix | upper }}_TRANSITION_INVALID_TARGET;
    }
    /* Check if transition is allowed */
    else if ({{ prefix | lower }}_transitionTable[(uint8_t)currentState][(uint8_t)targetState] == false) {
        result = {{ prefix | upper }}_TRANSITION_NOT_ALLOWED;
    }
    /* Validate preconditions */
    else if ({{ prefix | upper }}_ValidateTransitionPreconditions(targetState) == false) {
        result = {{ prefix | upper }}_TRANSITION_NOT_ALLOWED;
    }
    else {
        /* Execute exit actions for current state */
        {{ prefix | upper }}_ExecuteExitActions(currentState);

        /* Update state context */
        {{ prefix | lower }}_stateContext.previousState = currentState;
        {{ prefix | lower }}_stateContext.currentState = targetState;
        {{ prefix | lower }}_stateContext.lastTransitionTimestamp_ms = OS_GetTickCount();
        {{ prefix | lower }}_stateContext.transitionCount++;

        /* Execute entry actions for new state */
        {{ prefix | upper }}_ExecuteEntryActions(targetState);
    }

    return result;
}

/**
 * @brief   Gets the current state
 * @return  Current state of the state machine
 * @req     {{ requirement_id }}
 */
{{ prefix | upper }}_STATE_e {{ prefix | upper }}_GetCurrentState(void) {
    /* FAS_ASSERT: State machine must be initialized */
    FAS_ASSERT({{ prefix | lower }}_stateContext.initialized == true);

    return {{ prefix | lower }}_stateContext.currentState;
}

/**
 * @brief   Gets the previous state
 * @return  Previous state before last transition
 * @req     {{ requirement_id }}
 */
{{ prefix | upper }}_STATE_e {{ prefix | upper }}_GetPreviousState(void) {
    /* FAS_ASSERT: State machine must be initialized */
    FAS_ASSERT({{ prefix | lower }}_stateContext.initialized == true);

    return {{ prefix | lower }}_stateContext.previousState;
}

/**
 * @brief   Gets the transition count
 * @return  Total number of state transitions since initialization
 * @req     {{ requirement_id }}
 */
uint32_t {{ prefix | upper }}_GetTransitionCount(void) {
    return {{ prefix | lower }}_stateContext.transitionCount;
}

/**
 * @brief   Checks if a transition to target state is allowed
 * @param   targetState The target state to check
 * @return  true if transition is allowed, false otherwise
 * @req     {{ requirement_id }}
 */
bool {{ prefix | upper }}_IsTransitionAllowed({{ prefix | upper }}_STATE_e targetState) {
    bool allowed = false;
    {{ prefix | upper }}_STATE_e currentState = {{ prefix | lower }}_stateContext.currentState;

    /* FAS_ASSERT: State machine must be initialized */
    FAS_ASSERT({{ prefix | lower }}_stateContext.initialized == true);

    if (({{ prefix | upper }}_IsValidState(currentState) == true) &&
        ({{ prefix | upper }}_IsValidState(targetState) == true)) {
        allowed = {{ prefix | lower }}_transitionTable[(uint8_t)currentState][(uint8_t)targetState];
    }

    return allowed;
}

