/**
 * @brief   State transition table
 * @details Defines allowed transitions from each state.
 *          Row index = current state, column = target state
 *          true = transition allowed, false = transition not allowed
 * @req     {{ requirement_id }}
 */
static const bool {{ prefix | lower }}_transitionTable[{{ prefix | upper }}_NUMBER_OF_STATES][{{ prefix | upper }}_NUMBER_OF_STATES] = {
{% for from_state in states %}
    /* From {{ from_state.name | upper }} */
    {
{% for to_state in states %}
{% set allowed = from_state.name in transitions and to_state.name in transitions[from_state.name] %}
        {{ 'true' if allowed else 'false' }}{% if not loop.last %},{% endif %}  /* to {{ to_state.name | upper }} */
{% endfor %}
    }{% if not loop.last %},{% endif %}

{% endfor %}
};

/** @brief State machine context instance */
static {{ prefix | upper }}_STATE_CONTEXT_s {{ prefix | lower }}_stateContext = {
    .currentState = {{ prefix | upper }}_STATE_{{ initial_state | upper | default('IDLE') }},
    .previousState = {{ prefix | upper }}_STATE_{{ initial_state | upper | default('IDLE') }},
    .lastTransitionTimestamp_ms = 0u,
    .transitionCount = 0u,
    .initialized = false
};

